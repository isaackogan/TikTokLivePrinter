{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiktok-live-printer-docs",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    {
      "pattern": "ttlp.docs.isaackogan.com",
      "custom_domain": true
    }
  ]
}
